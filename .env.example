# Eksempel-miljøvariabler for north-installasjon.
# Kopier til .env.local og fyll inn faktiske verdier (committ aldri .env.local).

# --- Monday.com lead-integrasjon (påkrevd) ---
# Server-side kun. ALDRI prefiks med NEXT_PUBLIC_.
MONDAY_API_KEY=
# Numerisk board-ID for CRM-tavlen leads skal lande på.
MONDAY_BOARD_ID=

# Valgfri overstyring av hvilken Monday-kolonne adressen havner i.
MONDAY_ADDRESS_COLUMN_ID=
MONDAY_ADDRESS_COLUMN_TYPE=

# --- E-postvarsel (Resend, valgfri) ---
# Brukes kun når en innsending har vedlegg.
RESEND_API_KEY=

# --- Google Maps Platform (valgfri) ---
# Places-autocomplete på adressefeltet i priskalkulatoren.
# Uten nøkkel blir feltet et vanlig tekstfelt.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

